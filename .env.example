# =============================================================
# Supabase Configuration — COPY THIS FILE TO .env AND FILL IN
# =============================================================
# Find these values in your Supabase project:
# Dashboard → Settings → API

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/publishable key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================
# NEVER put the following in this file or commit them to git:
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_JWT_SECRET
# Any database passwords
# =============================================================
